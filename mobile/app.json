{
  "expo": {
    "name": "NetProfit",
    "slug": "netprofit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.netprofit.app",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.netprofit.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#1f6fb2",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow NetProfit to scan pairing QR codes."
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-status-bar",
      "expo-font",
      "expo-sharing"
    ]
  }
}
