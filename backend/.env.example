# Copy this file to .env and fill in real values. Never commit .env.

# Required. Signing key for future device-pairing tokens (Section 5.1).
# App will refuse to boot if this is unset or shorter than 32 characters (fail-closed).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
DEVICE_TOKEN_SIGNING_KEY=

# Optional overrides
DATABASE_PATH=data/netprofit.db
# Extra copy of each daily backup, for example a USB drive or a synced folder (leave empty to skip).
BACKUP_COPY_DIR=
